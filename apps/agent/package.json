{
  "name": "@paymap/agent",
  "version": "0.1.0",
  "type": "module",
  "description": "PAYMAP agent surface — MCP server + x402 payment client for the Stellar Bazaar",
  "bin": {
    "paymap-mcp": "./src/mcp-server.mjs",
    "paymap": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/pay.mjs",
    "./pay": "./src/pay.mjs",
    "./bazaar": "./src/bazaar.mjs",
    "./mcp-server": "./src/mcp-server.mjs"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "x402",
    "stellar",
    "mcp",
    "model-context-protocol",
    "agent-payments",
    "bazaar",
    "paymap"
  ],
  "homepage": "https://github.com/pedro-pelicioni/paymap/tree/main/apps/agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedro-pelicioni/paymap.git",
    "directory": "apps/agent"
  },
  "bugs": {
    "url": "https://github.com/pedro-pelicioni/paymap/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "mcp": "node src/mcp-server.mjs",
    "demo": "node src/cli.mjs",
    "test": "node --test src/replay-guard.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "@x402/core": "^2.21.0",
    "@x402/fetch": "^2.21.0",
    "@x402/stellar": "^2.21.0",
    "picocolors": "^1.1.1",
    "zod": "^3.25.76"
  },
  "license": "Apache-2.0"
}
